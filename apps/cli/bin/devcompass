#!/usr/bin/env bash

set -Eeuo pipefail

# Resolve canonical DevCompass root directory
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVCOMPASS_ROOT="$(cd "${BIN_DIR}/../../.." && pwd)"
export DEVCOMPASS_ROOT

# Source core library
# shellcheck source=apps/cli/lib/core.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/core.sh"

# Source profiles library
# shellcheck source=apps/cli/lib/profiles.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/profiles.sh"
# shellcheck source=apps/cli/lib/knowledge.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/knowledge.sh"
# shellcheck source=apps/cli/lib/recommendations.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/recommendations.sh"

# Source checks
# shellcheck source=apps/cli/lib/checks/system.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/checks/system.sh"
# shellcheck source=apps/cli/lib/checks/xcode.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/checks/xcode.sh"
# shellcheck source=apps/cli/lib/checks/homebrew.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/checks/homebrew.sh"
# shellcheck source=apps/cli/lib/checks/git.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/checks/git.sh"
# shellcheck source=apps/cli/lib/checks/python.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/checks/python.sh"
# shellcheck source=apps/cli/lib/checks/node.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/checks/node.sh"

# Source commands
# shellcheck source=apps/cli/lib/commands/help.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/help.sh"
# shellcheck source=apps/cli/lib/commands/version.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/version.sh"
# shellcheck source=apps/cli/lib/commands/doctor.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/doctor.sh"
# shellcheck source=apps/cli/lib/commands/init.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/init.sh"
# shellcheck source=apps/cli/lib/commands/profile.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/profile.sh"
# shellcheck source=apps/cli/lib/commands/knowledge.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/knowledge.sh"
# shellcheck source=apps/cli/lib/commands/recommend.sh
source "${DEVCOMPASS_ROOT}/apps/cli/lib/commands/recommend.sh"

main() {
    local command=""
    local command_args=()
    local profile_flag=false
    local dry_run_flag=false
    local assume_yes_flag=false
    export DEVCOMPASS_DRY_RUN="${DEVCOMPASS_DRY_RUN:-false}"
    export DEVCOMPASS_ASSUME_YES="${DEVCOMPASS_ASSUME_YES:-false}"
    export DEVCOMPASS_PROFILE="${DEVCOMPASS_PROFILE:-foundation}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                cmd_help
                exit 0
                ;;
            --version|-v)
                cmd_version
                exit 0
                ;;
            --no-color)
                export NO_COLOR="1"
                ;;
            --dry-run)
                export DEVCOMPASS_DRY_RUN="true"
                dry_run_flag=true
                ;;
            --yes|-y)
                export DEVCOMPASS_ASSUME_YES="true"
                assume_yes_flag=true
                ;;
            --profile)
                if [[ $# -lt 2 ]]; then
                    log_error "--profile requires a profile name (e.g. foundation, web, data-science, devops)"
                    exit 1
                fi
                export DEVCOMPASS_PROFILE="$2"
                profile_flag=true
                shift
                ;;
            --profile=*)
                export DEVCOMPASS_PROFILE="${1#*=}"
                profile_flag=true
                ;;
            doctor|init|profile|knowledge|recommend|version|help)
                if [[ -z "$command" ]]; then
                    command="$1"
                else
                    command_args+=("$1")
                fi
                ;;
            *)
                if [[ -n "$command" ]]; then
                    command_args+=("$1")
                else
                    log_error "Unknown option or command: $1"
                    echo "Run 'devcompass --help' for usage."
                    exit 1
                fi
                ;;
        esac
        shift
    done

    if [[ -z "$command" ]]; then
        cmd_help
        exit 0
    fi

    case "$command" in
        init)
            if [[ ${#command_args[@]} -ne 0 ]]; then
                log_error "Unexpected arguments for 'init' command"
                exit 1
            fi
            ;;
        doctor|version|help)
            if [[ ${#command_args[@]} -ne 0 || "$profile_flag" == "true" || "$dry_run_flag" == "true" || "$assume_yes_flag" == "true" ]]; then
                log_error "Unsupported arguments or flags for '$command' command"
                exit 1
            fi
            ;;
        profile)
            if [[ "$profile_flag" == "true" || "$dry_run_flag" == "true" || "$assume_yes_flag" == "true" ]]; then
                log_error "Unsupported flags for 'profile' command"
                exit 1
            fi
            case "${command_args[0]:-list}" in
                list)
                    if [[ ${#command_args[@]} -gt 2 ]] || { [[ ${#command_args[@]} -eq 2 ]] && [[ "${command_args[1]}" != "--json" ]]; }; then
                        log_error "Usage: devcompass profile list [--json]"
                        exit 1
                    fi
                    ;;
                show)
                    if [[ ${#command_args[@]} -ne 2 ]]; then
                        log_error "Usage: devcompass profile show <id>"
                        exit 1
                    fi
                    ;;
                *)
                    log_error "Usage: devcompass profile [list [--json]|show <id>]"
                    exit 1
                    ;;
            esac
            ;;
        knowledge)
            case "${command_args[0]:-status}" in
                status|validate)
                    if [[ ${#command_args[@]} -gt 1 ]]; then
                        log_error "Usage: devcompass knowledge ${command_args[0]}"
                        exit 1
                    fi
                    ;;
                show)
                    if [[ ${#command_args[@]} -ne 2 ]]; then
                        log_error "Usage: devcompass knowledge show <id>"
                        exit 1
                    fi
                    ;;
                *)
                    log_error "Usage: devcompass knowledge [status|validate|show <id>]"
                    exit 1
                    ;;
            esac
            ;;
        recommend)
            if [[ "$profile_flag" == "true" || "$dry_run_flag" == "true" || "$assume_yes_flag" == "true" ]]; then
                log_error "Unsupported global flags for 'recommend' command"
                exit 1
            fi
            ;;
    esac

    case "$command" in
        help)
            cmd_help
            ;;
        version)
            cmd_version
            ;;
        doctor)
            cmd_doctor
            ;;
        init)
            cmd_init
            ;;
        profile)
            cmd_profile "${command_args[@]:-}"
            ;;
        knowledge)
            cmd_knowledge "${command_args[@]:-}"
            ;;
        recommend)
            cmd_recommend "${command_args[@]:-}"
            ;;
    esac
}

main "$@"
